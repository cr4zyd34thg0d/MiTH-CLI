# ==============================================================================
# MiTH CLI — Mobile-to-Computer AI CLI Configuration Template
# ==============================================================================
# Copy this file to `.env` (strictly git-ignored) or import directly into your
# OS Hardware Keychain via:
#   python3 secrets_keychain.py --import-env
# ==============================================================================

# 1. Server & Owner Authentication
POCKET_CLI_PORT=8788
POCKET_CLI_PIN=your_6_digit_pin_here

# 2. Desktop AI CLI & Workspace Settings
AGY_BIN_PATH=agy
AGY_WORKSPACE_DIR=/path/to/your/workspace
GEMINI_MODEL=auto
AGY_EFFORT=medium
AGY_TIMEOUT_SECONDS=1800

# 3. Optional: Public URL (Tailscale MagicDNS or Cloudflare Tunnel)
PUBLIC_CLI_URL=https://your-machine.tailnet.ts.net/cli

# 4. Optional: Discord 6-Digit Pairing Fallback (Leave blank if using PIN only)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
OWNER_USER_ID=
